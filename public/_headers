# Long-lived hashed build output; a week for hand-managed media that can be refreshed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/tex/*
  Cache-Control: public, max-age=604800
/img/*
  Cache-Control: public, max-age=604800
/sfx/*
  Cache-Control: public, max-age=604800
