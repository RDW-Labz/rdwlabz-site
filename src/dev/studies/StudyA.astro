---
import Icon from '../../components/Icon.astro';
import { featuredProjects, tagline, categories } from '../../lib/projects';
import type { CategoryId } from '../../lib/projects';

const featured = featuredProjects();
const tokenColor: Record<CategoryId, string> = {
  software: '#3d7bff',
  games: '#ff4d2e',
  mods: '#16b67e',
  'asset-packs': '#b04cf0',
};
---

<section class="study-a" data-study="a" aria-labelledby="a-title">
  <header class="a-header">
    <a class="a-logo" href="#a-title">
      <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
        <rect x="2" y="2" width="36" height="36" rx="12" fill="#1e1433"></rect>
        <path
          d="M16 10h8M17.5 10v7l-6 10.5A2.4 2.4 0 0 0 13.6 31h12.8a2.4 2.4 0 0 0 2.1-3.5l-6-10.5v-7"
          fill="none"
          stroke="#fff6ea"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M14 25.5h12l1.6 2.8a1.4 1.4 0 0 1-1.2 2.1H13.6a1.4 1.4 0 0 1-1.2-2.1Z"
          fill="#ffc23d"
        ></path>
        <circle cx="22" cy="21" r="1.6" fill="#ffc23d"></circle>
      </svg>
      <span>
        RDW <em>Labz</em>
      </span>
    </a>
    <nav aria-label="Study A">
      <a href="#a-title" class="a-nav is-active">
        Home
      </a>
      <a href="#a-proj" class="a-nav">
        Projects
      </a>
      <a href="#a-title" class="a-pill a-pill--ink">
        Contact
      </a>
    </nav>
  </header>

  <div class="a-hero">
    <div class="a-copy">
      <p class="a-eyebrow">
        <Icon name="sparkle" size={16} /> Indie dev lab
      </p>
      <h2 id="a-title">
        <span class="a-name">RDW Labz</span>
        <span class="a-tag">{tagline}</span>
      </h2>
      <div class="a-ctas">
        <a href="#a-proj" class="a-pill a-pill--primary">
          See our projects <Icon name="arrow-right" size={18} />
        </a>
        <span class="a-pill a-pill--soft" aria-disabled="true">
          <Icon name="mail" size={18} /> Email coming soon
        </span>
      </div>
    </div>

    <div class="a-bench" aria-hidden="true">
      <div class="a-bench__glow"></div>
      <div class="a-bench__core">
        <svg viewBox="0 0 120 120" width="120" height="120">
          <path
            d="M48 22h24M52 22v22L32 78a7 7 0 0 0 6 10.5h44A7 7 0 0 0 88 78L68 44V22"
            fill="#fff6ea"
            stroke="#1e1433"
            stroke-width="6"
            stroke-linejoin="round"
            stroke-linecap="round"
          ></path>
          <path d="M40 66h40l8 13a6 6 0 0 1-5 9H37a6 6 0 0 1-5-9Z" fill="#ff4d2e"></path>
          <circle class="a-bubble b1" cx="56" cy="58" r="4" fill="#ffc23d"></circle>
          <circle class="a-bubble b2" cx="66" cy="50" r="3" fill="#ffc23d"></circle>
        </svg>
      </div>
      {categories.map((c, i) => (
        <div class={`a-token a-token--${i}`} style={`--tok:${tokenColor[c.id]}`}>
          <Icon name={c.id} size={26} />
          <span>{c.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="a-proj" id="a-proj">
    <div class="a-proj__head">
      <h3>Fresh from the lab</h3>
      <a href="#a-proj" class="a-link">
        All projects <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <ul class="a-grid">
      {featured.map((p) => (
        <li class="a-card" style={`--acc:${p.accent}`}>
          <div class="a-card__art">
            <Icon name={p.category} size={56} strokeWidth={1.6} />
          </div>
          <div class="a-card__body">
            <div class="a-chips">
              <span class="a-chip a-chip--cat">{p.categoryText}</span>
              <span class="a-chip a-chip--status">
                <Icon name="clock" size={14} /> {p.statusText}
              </span>
            </div>
            <h4>{p.title}</h4>
            <p>{p.blurb}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .study-a {
    --ink: #1e1433;
    --paper: #fff6ea;
    --tomato: #ff4d2e;
    --sun: #ffc23d;
    font-family: var(--font-a-body);
    color: var(--ink);
    background:
      radial-gradient(circle at 1px 1px, rgb(30 20 51 / 0.12) 1px, transparent 0) 0 0 / 22px 22px,
      var(--paper);
    padding: 20px clamp(16px, 4vw, 48px) 0;
    overflow: hidden;
  }
  .a-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 10px 10px 14px;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 4px 0 var(--ink);
  }
  .a-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-a-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .a-logo em {
    font-style: normal;
    color: var(--tomato);
  }
  .a-header nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .a-nav {
    padding: 10px 16px;
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .a-nav.is-active {
    background: #ffe7c7;
  }
  .a-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 120ms,
      box-shadow 120ms;
  }
  .a-pill--ink {
    background: var(--ink);
    color: #fff;
    min-height: 44px;
  }
  .a-pill--primary {
    background: var(--tomato);
    color: #fff;
    box-shadow: 0 4px 0 var(--ink);
  }
  .a-pill--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--ink);
  }
  .a-pill--soft {
    background: #fff;
    border-style: dashed;
    color: #5a4e6e;
  }
  .a-hero {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 32px;
    padding: 64px 0 88px;
  }
  .a-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--sun);
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 14px;
    margin: 0 0 20px;
  }
  .a-copy h2 {
    margin: 0;
    font-family: var(--font-a-display);
  }
  .a-name {
    display: block;
    font-size: clamp(64px, 9vw, 132px);
    line-height: 0.88;
    font-weight: 800;
    letter-spacing: -0.045em;
    font-variation-settings: 'wdth' 85;
  }
  .a-tag {
    display: block;
    margin-top: 20px;
    max-width: 22ch;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .a-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .a-bench {
    position: relative;
    aspect-ratio: 1;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    border-radius: 48px;
    background: linear-gradient(145deg, #ffd77a, #ff8a5c 55%, #ff5fa2);
    border: 2px solid var(--ink);
    box-shadow: 0 8px 0 var(--ink);
  }
  .a-bench__glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6 0, transparent 70%);
  }
  .a-bench__core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 168px;
    height: 168px;
    border-radius: 44px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
    animation: a-wobble 3.2s ease-in-out infinite;
  }
  .a-bubble {
    animation: a-rise 2.4s ease-in infinite;
  }
  .a-bubble.b2 {
    animation-delay: 1.1s;
  }
  .a-token {
    --x: 0;
    --y: 0;
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px 10px 12px;
    border-radius: 999px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 0 4px 0 var(--ink);
    font-weight: 700;
    white-space: nowrap;
    color: var(--ink);
    translate: -50% -50%;
    animation: a-spawn 900ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .a-token :global(svg) {
    color: var(--tok);
  }
  .a-token--0 {
    --x: -120px;
    --y: -150px;
    animation-delay: 200ms;
  }
  .a-token--1 {
    --x: 130px;
    --y: -110px;
    animation-delay: 340ms;
  }
  .a-token--2 {
    --x: -140px;
    --y: 130px;
    animation-delay: 480ms;
  }
  .a-token--3 {
    --x: 120px;
    --y: 160px;
    animation-delay: 620ms;
  }
  @keyframes a-spawn {
    from {
      transform: translate(0, 0) scale(0.2) rotate(-20deg);
      opacity: 0;
    }
    to {
      transform: translate(var(--x), var(--y)) scale(1) rotate(0);
      opacity: 1;
    }
  }
  @keyframes a-wobble {
    0%,
    100% {
      rotate: -3deg;
    }
    50% {
      rotate: 3deg;
    }
  }
  @keyframes a-rise {
    from {
      transform: translateY(0);
      opacity: 1;
    }
    to {
      transform: translateY(-30px);
      opacity: 0;
    }
  }

  .a-proj {
    margin: 0 calc(-1 * clamp(16px, 4vw, 48px));
    padding: 64px clamp(16px, 4vw, 48px) 80px;
    border-radius: 56px 56px 0 0;
    background: linear-gradient(180deg, #ffe0bd 0%, #ffd2e1 100%);
    border-top: 2px solid var(--ink);
  }
  .a-proj__head {
    max-width: 1240px;
    margin: 0 auto 32px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }
  .a-proj h3 {
    margin: 0;
    font-family: var(--font-a-display);
    font-size: clamp(36px, 5vw, 60px);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .a-link {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-weight: 700;
    color: var(--ink);
  }
  .a-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1240px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .a-card {
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 32px;
    box-shadow: 0 6px 0 var(--acc);
    overflow: hidden;
    transition:
      transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 160ms;
  }
  .a-card:hover {
    transform: translateY(-6px) rotate(-1.2deg);
    box-shadow: 0 12px 0 var(--acc);
  }
  .a-card__art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin: 10px;
    border-radius: 24px;
    color: #fff;
    background:
      repeating-linear-gradient(-45deg, #ffffff22 0 12px, transparent 12px 24px),
      linear-gradient(135deg, var(--acc), color-mix(in oklab, var(--acc), #1e1433 35%));
  }
  .a-card__body {
    padding: 8px 22px 24px;
  }
  .a-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .a-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    border: 1.5px solid var(--ink);
  }
  .a-chip--cat {
    background: color-mix(in oklab, var(--acc), #fff 80%);
  }
  .a-chip--status {
    background: #fff;
  }
  .a-card h4 {
    margin: 14px 0 6px;
    font-family: var(--font-a-display);
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .a-card p {
    margin: 0;
    color: #4f4466;
  }

  @media (max-width: 860px) {
    .a-hero {
      grid-template-columns: 1fr;
      padding: 40px 0 56px;
    }
    .a-header nav .a-nav {
      display: none;
    }
    .a-bench {
      max-width: 360px;
    }
    .a-bench__core {
      width: 120px;
      height: 120px;
      border-radius: 32px;
    }
    .a-bench__core svg {
      width: 84px;
      height: 84px;
    }
    .a-token {
      font-size: 14px;
      padding: 8px 12px 8px 10px;
    }
    .a-token--0 {
      --x: -70px;
      --y: -120px;
    }
    .a-token--1 {
      --x: 80px;
      --y: -90px;
    }
    .a-token--2 {
      --x: -80px;
      --y: 100px;
    }
    .a-token--3 {
      --x: 70px;
      --y: 130px;
    }
    .a-proj {
      border-radius: 36px 36px 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .study-a *,
    .study-a *::before {
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      transition: none !important;
    }
  }
</style>
