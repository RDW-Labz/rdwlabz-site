---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ContactButton from '../components/ContactButton.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import LabBench from '../components/home/LabBench.astro';
import LabActivity from '../components/home/LabActivity.astro';
import PopHeading from '../components/PopHeading.astro';
import LibraryTeaser from '../components/library/LibraryTeaser.astro';
import { packs as libraryPacks } from '../lib/library';
import {
  activeCategories,
  allProjects,
  buildPhrase,
  categoryAccent,
  categoryBlurb,
  categoryInk,
  countIn,
  countLabel,
  customTagline,
  featuredProjects,
  isTodo,
  labActivity,
  pluralProjects,
  site,
  tagline,
} from '../lib/projects';

/** With a single active category, it takes over the "What we build" slot with its projects. */
const spotlight = activeCategories.length === 1 ? activeCategories[0] : null;
const spotlightItems = spotlight ? allProjects().filter((p) => p.category === spotlight.id) : [];
const featured = spotlight ? [] : featuredProjects().slice(0, 6);
const fillerSpan = featured.length > 0 && featured.length < 3 ? 3 - featured.length : 0;
const workWithUs = isTodo(site.workWithUs) ? null : site.workWithUs;
const activity = labActivity(3);
const buildLine = `We build ${buildPhrase}.`;
const kinds = ['', 'One', 'Two', 'Three', 'Four'][activeCategories.length] ?? 'A few';
---

<BaseLayout description={tagline} current="home">
  <!-- 1. Hero: who we are -->
  <section class="hero container-lab" aria-labelledby="hero-title" data-hero>
    <div class="hero__copy">
      <p class="eyebrow">
        <Icon name="sparkle" size={16} /> Hello from the lab
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">
          <span class="hero__word">RDW</span> <span class="hero__word hero__labz">Labz</span>
        </span>
        <span class:list={['hero__tag', activeCategories.length < 2 && 'hero__tag--still']}>
          <span class="hero__tag-static">{buildLine}</span>
          <span class="hero__tag-cycle" aria-hidden="true" data-loop>
            We build{' '}
            <span class="cycler">
              {activeCategories.map((c, i) => (
                <span
                  class:list={['cycler__word', i === 0 && 'is-on']}
                  style={`--c:${categoryInk[c.id]}; --u:${categoryAccent[c.id]}`}
                  data-word
                >
                  {[...c.label.toLowerCase()].map((ch, li) => (
                    <span class="cycler__l" style={`--li:${li}`}>
                      {ch}
                    </span>
                  ))}
                </span>
              ))}
            </span>
          </span>
        </span>
      </h1>
      {customTagline && <p class="hero__lead">{customTagline}</p>}
      <div class="hero__ctas">
        <Button href="/projects" variant="primary" iconEnd="arrow-right">
          See our projects
        </Button>
        <ContactButton variant="secondary" />
      </div>
    </div>
    <div class="hero__stage">
      <LabBench />
      <button
        type="button"
        class="btn btn--ghost btn--sm hero__pause"
        aria-pressed="false"
        data-motion-toggle
      >
        <Icon name="pause" size={18} />
        <span data-motion-label>Pause animations</span>
      </button>
    </div>
  </section>

  <!-- 2. What we build: tiles per active category, or the only active category's projects -->
  {spotlight ? (
    <Section tone="peach" id="what-we-build" labelledby="wwb-title">
      <div class="section-head section-head--split" data-reveal>
        <div class="spotlight-head">
          <p class="eyebrow">
            <Icon name={spotlight.id} size={16} /> What we build
          </p>
          <PopHeading id="wwb-title" class="text-h2" text={spotlight.label} />
          <p class="section-head__lead">
            {categoryBlurb(spotlight) ??
              `${pluralProjects(spotlightItems.length)} from the lab, out now or on the way.`}
          </p>
        </div>
        <Button
          href={`/projects?c=${spotlight.id}`}
          variant="secondary"
          size="sm"
          iconEnd="arrow-right"
        >
          All {spotlight.label.toLowerCase()}
        </Button>
      </div>
      <ul
        class="featured-grid featured-grid--fit"
        style={`--cols:${Math.min(spotlightItems.length, 3)}`}
      >
        {spotlightItems.map((p, i) => (
          <li data-reveal="rise" style={`--reveal-i:${i}`}>
            <ProjectCard project={p} />
          </li>
        ))}
      </ul>
      <LabActivity items={activity} />
    </Section>
  ) : activeCategories.length > 1 ? (
    <Section tone="peach" id="what-we-build" labelledby="wwb-title">
      <div class="section-head" data-reveal>
        <PopHeading id="wwb-title" class="text-h2" text="What we build" />
        <p class="section-head__lead">
          {kinds} kinds of things come out of the lab. Pick one to browse.
        </p>
      </div>
      <ul class="tiles">
        {activeCategories.map((c, i) => {
          const n = countIn(c.id);
          const blurb = categoryBlurb(c);
          return (
            <li data-reveal style={`--reveal-i:${i}`}>
              <a href={`/projects?c=${c.id}`} class="tile" style={`--acc:${categoryAccent[c.id]}`}>
                <span class="tile__no" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="tile__icon" aria-hidden="true">
                  <Icon name={c.id} size={36} strokeWidth={1.8} />
                </span>
                <span class="tile__label">{c.label}</span>
                {blurb && <span class="tile__blurb">{blurb}</span>}
                <span class="tile__meta">
                  {countLabel(n)}
                  <Icon name="arrow-right" size={18} class="tile__arrow" />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </Section>
  ) : null}

  <!-- 2b. Clay Asset Library teaser (only when the library has packs) -->
  {libraryPacks.length > 0 && <LibraryTeaser packs={libraryPacks} />}

  <!-- 3. Featured projects (the spotlight above already shows them when there's one category) -->
  {!spotlight && (
    <Section tone="mint" id="featured" labelledby="featured-title">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <PopHeading id="featured-title" class="text-h2" text="Fresh from the lab" />
          <p class="section-head__lead">A few things we're working on.</p>
        </div>
        <Button href="/projects" variant="secondary" size="sm" iconEnd="arrow-right">
          All projects
        </Button>
      </div>
      {featured.length > 0 ? (
        <ul class="featured-grid">
          {featured.map((p, i) => (
            <li data-reveal="rise" style={`--reveal-i:${i}`}>
              <ProjectCard project={p} />
            </li>
          ))}
          {fillerSpan > 0 && (
            <li
              data-reveal="rise"
              class="filler-slot"
              style={`--span:${fillerSpan}; --reveal-i:${featured.length}`}
            >
              <a href="/projects" class="filler">
                <span class="filler__icon" aria-hidden="true">
                  <Icon name="flask" size={32} strokeWidth={1.8} />
                </span>
                <span class="filler__title">More on the shelf</span>
                <span class="filler__text">
                  See everything we’re building <Icon name="arrow-right" size={18} />
                </span>
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p class="empty-note" data-reveal>
          Featured projects are on their way.{' '}
          <a class="link" href="/projects">
            Browse everything
          </a>
        </p>
      )}
      <LabActivity items={activity} />
    </Section>
  )}

  <!-- 4. Work with us -->
  <Section tone="paper" id="work-with-us" labelledby="wwu-title">
    <div class="wwu" data-reveal>
      <div class="wwu__intro">
        <p class="eyebrow eyebrow--mint">For clients &amp; collaborators</p>
        <PopHeading id="wwu-title" class="text-h2" text="Work with us" />
        <p class="wwu__lead">
          Have an idea for software, a game, a mod or an asset pack? Tell us about it.
        </p>
        {workWithUs && <p class="wwu__extra">{workWithUs}</p>}
        <div class="wwu__cta">
          <ContactButton variant="primary" label="Email us about a project" />
        </div>
      </div>
      <div class="wwu__note sticker">
        <h3 class="wwu__note-title">Handy things to include in your email</h3>
        <ol class="wwu__list">
          <li>
            <span>1</span>What you want to build, in a sentence or two
          </li>
          <li>
            <span>2</span>Links or references that show the vibe
          </li>
          <li>
            <span>3</span>Rough timing, if you have one
          </li>
        </ol>
      </div>
    </div>
  </Section>

  <!-- 5. CTA band -->
  <Section tone="ink" id="say-hi" labelledby="cta-title" class="cta-band">
    <div class="cta" data-reveal>
      <PopHeading id="cta-title" class="cta__title" text="Say hi to the lab." />
      <p class="cta__lead">Questions, ideas or collabs. One email away.</p>
      <div class="cta__actions">
        <ContactButton variant="sun" />
        <a href="/projects" class="link">
          Or browse our projects
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import { initHero } from '../scripts/hero';
  import { initLoopVideos } from '../scripts/loop-video';
  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:page-load', initLoopVideos);
</script>

<style>
  .hero {
    display: grid;
    gap: 40px;
    align-items: center;
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: calc(var(--tray-r) + clamp(48px, 7vw, 96px));
    /* The swaying token layer's rotated corners must not cause sideways scroll at 320px. */
    overflow-x: clip;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__title {
    margin: 20px 0 0;
  }
  .hero__name {
    display: block;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: -0.02em;
  }
  .hero__word {
    display: inline-block;
    animation: name-pop 820ms var(--ease-spring) both;
  }
  .hero__labz {
    color: var(--color-tomato-700);
    animation-delay: 140ms;
  }
  @keyframes name-pop {
    from {
      transform: translateY(0.2em) scale(0.72) rotate(-7deg);
    }
    to {
      transform: none;
    }
  }
  .hero__tag {
    display: block;
    margin-top: 20px;
    max-width: 22ch;
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .hero__lead {
    margin: 14px 0 0;
    max-width: 34ch;
    font-size: 1.1875rem;
    color: var(--color-ink-soft);
  }

  /* Cycler: shown only with JS and motion allowed; the full sentence stays for screen readers. */
  .hero__tag-cycle {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__tag-cycle {
      display: block;
    }
    :global(.js) .hero__tag-static {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    :global(html[data-motion='paused']) .hero__tag-cycle,
    .hero__tag--still .hero__tag-cycle {
      display: none;
    }
    :global(html[data-motion='paused']) .hero__tag-static,
    .hero__tag--still .hero__tag-static {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      white-space: normal;
    }
  }
  .cycler {
    display: inline-grid;
    vertical-align: bottom;
    perspective: 420px;
  }
  .cycler__word {
    grid-area: 1 / 1;
    white-space: nowrap;
    color: var(--c);
    font-family: var(--font-display);
    font-weight: 400;
  }
  .cycler__l {
    display: inline-block;
    white-space: pre;
    opacity: 0;
    transform: translateY(0.5em) rotateX(-80deg);
    transform-origin: 50% 100%;
    transition:
      transform 540ms var(--ease-spring),
      opacity 220ms var(--ease-out-soft);
    transition-delay: calc(var(--li) * 32ms);
  }
  .is-on .cycler__l {
    opacity: 1;
    transform: none;
  }
  .is-off .cycler__l {
    opacity: 0;
    transform: translateY(-0.45em) rotateX(80deg);
    transition-duration: 280ms, 200ms;
    transition-timing-function: var(--ease-out-soft);
  }

  .hero__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }
  .hero__pause {
    gap: 8px;
  }
  :global(html:not(.js)) .hero__pause {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__pause {
      visibility: hidden;
    }
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
    }
  }

  .section-head {
    max-width: 46rem;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .section-head--split {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    max-width: none;
  }
  .spotlight-head :global(h2) {
    margin: 14px 0 0;
  }
  .section-head__lead {
    margin: 12px 0 0;
    font-size: 1.1875rem;
    color: var(--color-ink-soft);
  }

  .tiles {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    min-height: clamp(12rem, 9rem + 8vw, 15rem);
    padding: clamp(16px, 2vw, 22px);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 2px solid var(--color-ink);
    box-shadow: 0 6px 0 var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 160ms var(--ease-spring),
      box-shadow 160ms,
      background-color 160ms;
  }
  .tile::after {
    content: '';
    position: absolute;
    right: -40px;
    bottom: -40px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--acc), #fff 70%);
    z-index: 0;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .tile > * {
    position: relative;
    z-index: 1;
  }
  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 12px 0 var(--acc);
  }
  .tile:hover::after,
  .tile:focus-visible::after {
    transform: scale(1.5);
  }
  .tile:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--acc);
  }
  .tile__no {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }
  .tile__icon {
    display: grid;
    place-items: center;
    width: clamp(52px, 4vw + 36px, 64px);
    height: clamp(52px, 4vw + 36px, 64px);
    margin: 8px 0 auto;
    border-radius: 22px;
    background: var(--acc);
    color: #fff;
    border: 2px solid var(--color-ink);
    transition: transform var(--dur-fast) var(--ease-spring);
  }
  .tile:hover .tile__icon,
  .tile:focus-visible .tile__icon {
    transform: rotate(-8deg) scale(1.06);
    animation: tile-wiggle 650ms var(--ease-spring);
  }
  @keyframes tile-wiggle {
    0%,
    100% {
      rotate: 0deg;
    }
    20% {
      rotate: -14deg;
    }
    45% {
      rotate: 11deg;
    }
    70% {
      rotate: -5deg;
    }
  }
  .tile__label {
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem);
    line-height: 1;
    overflow-wrap: anywhere;
    letter-spacing: -0.03em;
  }
  .tile__blurb {
    color: var(--color-ink-soft);
  }
  .tile__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    font-weight: 700;
    font-size: var(--text-small);
  }
  .tile :global(.tile__arrow) {
    transition: transform var(--dur-instant) var(--ease-out-soft);
  }
  .tile:hover :global(.tile__arrow) {
    transform: translateX(4px);
  }

  .featured-grid {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .featured-grid--fit {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .filler-slot {
      grid-column: span var(--span);
    }
  }
  .filler {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 100%;
    min-height: 14rem;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 2px dashed color-mix(in oklab, var(--color-ink), transparent 45%);
    background: rgb(255 255 255 / 0.55);
    color: var(--color-ink);
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--dur-instant),
      border-color var(--dur-instant),
      transform 160ms var(--ease-spring);
  }
  .filler:hover,
  .filler:focus-visible {
    background: var(--color-surface);
    border-color: var(--color-ink);
    transform: translateY(-4px);
  }
  .filler__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 22px;
    background: var(--color-sun);
    border: 2px solid var(--color-ink);
    rotate: -6deg;
  }
  .filler__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h3);
  }
  .filler__text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--color-ink-soft);
  }
  .empty-note {
    font-size: 1.125rem;
  }

  .wwu {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .wwu {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
    }
  }
  .eyebrow--mint {
    background: var(--color-mint-tint);
  }
  .wwu :global(h2) {
    margin: 16px 0 0;
  }
  .wwu__lead {
    margin: 16px 0 0;
    max-width: 30ch;
    font-size: var(--text-lead);
    line-height: 1.25;
    font-weight: 600;
  }
  .wwu__extra {
    margin: 14px 0 0;
    color: var(--color-ink-soft);
  }
  .wwu__cta {
    margin-top: 24px;
  }
  .wwu__note {
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-lg);
    rotate: 1.2deg;
    background:
      linear-gradient(transparent 31px, rgb(30 20 51 / 0.08) 32px) 0 12px / 100% 32px,
      #fffdf7;
  }
  .wwu__note-title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-weight: 700;
  }
  .wwu__list {
    display: grid;
    gap: 14px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .wwu__list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-weight: 600;
  }
  .wwu__list span {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-sun);
    border: 2px solid var(--color-ink);
    font-weight: 800;
    font-size: 0.875rem;
    translate: 0 -2px;
  }

  .cta {
    text-align: center;
    padding: clamp(8px, 2vw, 24px) 0;
  }
  .cta :global(.cta__title) {
    margin: 0;
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cta__lead {
    margin: 18px auto 0;
    max-width: 34ch;
    font-size: 1.25rem;
    color: var(--color-muted-on-ink);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  :global(.cta-band) {
    padding-bottom: clamp(56px, 7vw, 96px) !important;
  }
</style>
