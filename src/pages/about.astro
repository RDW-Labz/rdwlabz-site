---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ContactButton from '../components/ContactButton.astro';
import Icon from '../components/Icon.astro';
import PopHeading from '../components/PopHeading.astro';
import { allProjects, buildPhrase, contactHref, site } from '../lib/projects';

const items = allProjects();
const [street, ...rest] = site.address.split(', ');
const cityLine = rest.join(', ');
---

<BaseLayout
  title="About"
  description={`${site.name} is the dev studio brand of ${site.company}, based in Harrison, Arkansas. We build ${buildPhrase}.`}
  current="about"
>
  <section class="intro container-lab" aria-labelledby="about-title">
    <p class="eyebrow">
      <Icon name="flask" size={16} /> About
    </p>
    <PopHeading as="h1" id="about-title" class="intro__title" text="About us" />
    <p class="intro__lead">
      {site.name} is the dev studio brand of {site.company}, based in Harrison, Arkansas. We build{' '}
      {buildPhrase}.
    </p>
  </section>

  <Section tone="peach" labelledby="who-title" class="about-tray">
    <div class="about-grid">
      <div class="about-copy" data-reveal>
        <h2 id="who-title" class="text-h2">
          Who we are
        </h2>
        <p>
          {site.name} is how {site.company} makes and ships its own {buildPhrase}. The projects on
          this site are built and owned by {site.company}.
        </p>
        <h2 class="text-h2 about-copy__next">What we’re building</h2>
        {items.length > 0 ? (
          <ul class="about-list">
            {items.map((p) => (
              <li style={`--acc:${p.accent}`}>
                <span class="about-list__name">{p.title}</span>
                <span class="about-list__meta">
                  {p.categoryText} · {p.statusText}
                  {p.platforms.length > 0 && ` · ${p.platforms.join(', ')}`}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p>Our first projects are on the way.</p>
        )}
        <div class="about-copy__cta">
          <Button href="/projects" variant="secondary" iconEnd="arrow-right">
            See the projects
          </Button>
        </div>
      </div>

      <aside class="about-card sticker" aria-labelledby="company-title" data-reveal>
        <h2 id="company-title" class="about-card__title">
          Company details
        </h2>
        <dl>
          <div>
            <dt>Company</dt>
            <dd>{site.company}</dd>
          </div>
          <div>
            <dt>Brand</dt>
            <dd>{site.name}</dd>
          </div>
          <div>
            <dt>Address</dt>
            <dd>
              <address>
                {street}
                <br />
                {cityLine}
                <br />
                United States
              </address>
            </dd>
          </div>
          {contactHref && (
            <div>
              <dt>Email</dt>
              <dd>
                <a class="link" href={contactHref}>
                  {site.contactEmail}
                </a>
              </dd>
            </div>
          )}
        </dl>
        <ContactButton variant="primary" label="Email us" class="w-full" />
      </aside>
    </div>
  </Section>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: calc(var(--tray-r) + clamp(32px, 5vw, 56px));
  }
  .intro :global(.intro__title) {
    margin: 18px 0 0;
    font-size: clamp(3.5rem, 1.8rem + 7vw, 7rem);
    line-height: var(--text-h1--line-height);
    letter-spacing: -0.02em;
  }
  .intro__lead {
    margin: 16px 0 0;
    max-width: 38ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    font-weight: 600;
  }
  .about-grid {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .about-grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .about-copy {
    max-width: 40rem;
    font-size: 1.125rem;
  }
  .about-copy h2 {
    margin: 0;
  }
  .about-copy p {
    margin: 14px 0 0;
  }
  .about-copy__next {
    margin-top: clamp(32px, 4vw, 48px) !important;
  }
  .about-list {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .about-list li {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 2px solid var(--color-ink);
    box-shadow: 0 4px 0 var(--acc);
  }
  .about-list__name {
    font-weight: 800;
    font-size: 1.25rem;
  }
  .about-list__meta {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .about-copy__cta {
    margin-top: 24px;
  }
  .about-card {
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .about-card__title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }
  .about-card dl {
    display: grid;
    gap: 16px;
    margin: 20px 0 24px;
  }
  .about-card dt {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-ink-soft);
  }
  .about-card dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .about-card address {
    font-style: normal;
  }
  :global(.about-tray) {
    min-height: 50vh;
  }
</style>
