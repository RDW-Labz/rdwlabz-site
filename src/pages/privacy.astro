---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isTodo, site } from '../lib/projects';

// Based on RDW-Labz/ship-pipeline docs/site/privacy-policy.md, trimmed to what our products do
// today: no accounts, ads, analytics or crash reporting in any app or game; data stays on the
// device; purchases go through the store. Keep it true: update this page, App Store privacy
// details and the Google Play Data safety form together before any product adds accounts,
// analytics, ads or a new store, and move EFFECTIVE_DATE (YYYY-MM-DD) when the text changes.
const EFFECTIVE_DATE = '2026-10-13';

const effective = isTodo(EFFECTIVE_DATE)
  ? null
  : new Date(`${EFFECTIVE_DATE}T00:00:00Z`).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    });
const email = site.contactEmail;
const mailto = `mailto:${email}`;
const [street, ...rest] = site.address.split(', ');
const cityLine = rest.join(', ');
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${site.company} handles information in its apps, games and websites.`}
  current="privacy"
>
  <article class="policy container-lab" aria-labelledby="privacy-title">
    <h1 id="privacy-title" class="policy__title">
      Privacy Policy
    </h1>
    {effective && (
      <p class="policy__date">
        <strong>Effective date:</strong> {effective}
      </p>
    )}

    <p>
      This policy explains how {site.company} (“RDW”, “we”, “us”) handles information in our apps,
      games and websites (together, our “products”).
    </p>

    <h2>Who we are</h2>
    <address>
      {site.company}
      <br />
      {street}
      <br />
      {cityLine}, United States
      <br />
      <a href={mailto}>{email}</a>
    </address>

    <h2>What we collect</h2>
    <p>We collect as little as we can. Our apps and games have no accounts or sign-ups.</p>
    <ul>
      <li>
        <strong>Information you give us.</strong> If you email us: your email address and whatever
        you include in your message.
      </li>
      <li>
        <strong>Game and app data.</strong> Progress, settings and whether you’ve unlocked a game
        are stored on your device so the product works. They are not sent to us.
      </li>
      <li>
        <strong>Purchases.</strong> If you buy something in one of our apps, Google Play or Apple’s
        App Store processes the payment. We receive a record of the purchase from the store, not
        your card details.
      </li>
    </ul>
    <p>
      We do <strong>not</strong> sell your personal information.
    </p>

    <h2>How we use it</h2>
    <ul>
      <li>To answer your messages and give support.</li>
      <li>To deliver and restore purchases.</li>
      <li>To keep our website working and secure.</li>
      <li>To meet legal obligations.</li>
    </ul>

    <h2>Who we share it with</h2>
    <p>We share information only with:</p>
    <ul>
      <li>
        <strong>Stores</strong> where our products are available (itch.io, Google Play and Apple’s
        App Store), which handle downloads and payments under their own privacy policies.
      </li>
      <li>
        <strong>Cloudflare</strong>, which hosts rdwlabz.com.
      </li>
      <li>
        <strong>Authorities</strong>, when the law requires it.
      </li>
    </ul>

    <h2>Advertising and tracking</h2>
    <p>
      Our apps and games do not show ads, do not use analytics or crash-reporting services, and do
      not track you across other companies’ apps or websites.
    </p>
    <p>
      Our games use Google Play’s billing library to handle purchases. Google’s billing library may
      send basic diagnostics to Google.
    </p>

    <h2>Website analytics</h2>
    <p>
      rdwlabz.com uses Cloudflare Web Analytics to count page views. It doesn’t use cookies and
      doesn’t collect personal data; we only see totals, such as which pages were visited and how
      often. Our apps and games don’t use it or any other analytics.
    </p>

    <h2>Children</h2>
    <p>
      Our products are not directed to children under 13, and we do not knowingly collect personal
      information from them. If you believe a child has given us personal information, email{' '}
      <a href={mailto}>{email}</a> and we will delete it.
    </p>

    <h2>How long we keep it</h2>
    <p>
      We keep information only as long as we need it for the purposes above, or as the law requires.
      When we no longer need it, we delete it or make it anonymous.
    </p>

    <h2>Your choices and rights</h2>
    <ul>
      <li>
        You can ask to see, correct or delete your information by emailing{' '}
        <a href={mailto}>{email}</a>.
      </li>
      <li>
        Uninstalling an app or clearing a game’s site data deletes the data stored on your device.
      </li>
      <li>
        Depending on where you live (for example California or the EU/UK), you may have more rights.
        Email us and we will respond as the law requires.
      </li>
    </ul>

    <h2>Security</h2>
    <p>
      We use reasonable safeguards to protect information. No method of storage or transmission is
      completely secure.
    </p>

    <h2>Changes</h2>
    <p>
      If we change this policy, we will update the effective date above. For important changes, we
      will tell you in the product or on this page.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy: <a href={mailto}>{email}</a>
      <br />
      {site.company}, {site.address}, United States
    </p>
  </article>
</BaseLayout>

<style>
  .policy {
    max-width: 46rem;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .policy__title {
    margin: 0;
    font-size: clamp(2.5rem, 1.6rem + 3.5vw, 4rem);
    line-height: 1.05;
  }
  .policy__date {
    margin: 12px 0 0;
    color: var(--color-ink-soft);
  }
  .policy h2 {
    margin: 2.25em 0 0.5em;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .policy p,
  .policy address {
    margin: 0.85em 0 0;
  }
  .policy address {
    font-style: normal;
  }
  .policy ul {
    margin: 0.85em 0 0;
    padding-left: 1.25em;
  }
  .policy li + li {
    margin-top: 0.5em;
  }
  .policy a {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
</style>
