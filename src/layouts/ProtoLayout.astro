---
import '../styles/prototype-fonts.css';
import '../styles/prototype.css';
import { site } from '../lib/projects';

interface Props {
  title?: string;
  description: string;
  route: 'home' | 'about';
  showBoot?: boolean;
  ogImage?: { src: string; width: number; height: number; alt: string };
}

const { title, description, route, showBoot = false, ogImage: og } = Astro.props;
const fullTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} — We build software, games and clay 3D.`;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL(og?.src ?? '/og.png', Astro.site);
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const isAbout = route === 'about';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0807" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og?.width ?? 1200)} />
    <meta property="og:image:height" content={String(og?.height ?? 630)} />
    <meta property="og:image:alt" content={og?.alt ?? 'RDW Labz wordmark'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href="/fonts/proto/instrument-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/proto/instrument-serif.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/proto/instrument-serif-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/proto/jetbrains-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/proto/vt323.woff2" as="font" type="font/woff2" crossorigin />

    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
      />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div id="site" data-route={route}>
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <filter id="wob" x="-6%" y="-6%" width="112%" height="112%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.035"
            numOctaves="2"
            seed="4"
            result="n"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="n"
            scale="3"
            xChannelSelector="R"
            yChannelSelector="G"
            result="d"
          />
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.06 0.9"
            numOctaves="2"
            seed="9"
            result="h"
          />
          <feColorMatrix
            in="h"
            type="matrix"
            values="0 0 0 0 0.25 0 0 0 0 0.2 0 0 0 0 0.15 0 0 0 0.55 -0.12"
            result="hc"
          />
          <feComposite in="hc" in2="d" operator="in" result="hm" />
          <feBlend in="hm" in2="d" mode="multiply" />
        </filter>
        <filter id="wobn" x="-3%" y="-3%" width="106%" height="106%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.02"
            numOctaves="2"
            seed="7"
            result="n"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="n"
            scale="2"
            xChannelSelector="R"
            yChannelSelector="G"
            result="d"
          />
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.05 0.8"
            numOctaves="2"
            seed="11"
            result="h"
          />
          <feColorMatrix
            in="h"
            type="matrix"
            values="0 0 0 0 0.3 0 0 0 0 0.25 0 0 0 0 0.2 0 0 0 0.3 -0.08"
            result="hc"
          />
          <feComposite in="hc" in2="d" operator="in" result="hm" />
          <feBlend in="hm" in2="d" mode="multiply" />
        </filter>
      </svg>

      <canvas id="gl" aria-hidden="true"></canvas>

      {showBoot && (
        <div id="boot" role="status" aria-label="Loading">
          <div class="crt">
            <pre id="bootLines" />
            <p class="bootTitle">RDW Labz</p>
            <div class="bar" id="bootBar">
              <i />
            </div>
            <p class="skip">click or press any key to skip</p>
          </div>
        </div>
      )}

      <header id="nav">
        <a class="logo" href="/">
          RDW Labz
        </a>
        <nav class="links" aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/about" aria-current={isAbout ? 'page' : undefined}>
            About
          </a>
          <a href="/#contact">Contact</a>
          <span class="sndWrap" id="sndWrap">
            <button
              type="button"
              id="sndBtn"
              class="snd"
              aria-pressed="false"
              aria-label="Sound"
              title="Sound: off"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 9h4l5-4v14l-5-4H4z" />
                <path class="w" d="M16.5 8.5a5 5 0 010 7M19 6a8.5 8.5 0 010 12" />
                <path class="x" d="M16 9l5 6M21 9l-5 6" />
              </svg>
            </button>
            <span class="sndPop" id="sndPop" role="group" aria-label="Sound settings">
              <label>
                Volume <input type="range" id="sndVol" min="0" max="100" value="80" />
              </label>
              <label class="chk">
                <input type="checkbox" id="sndWhine" checked /> CRT whine (15.7 kHz)
              </label>
            </span>
          </span>
        </nav>
      </header>

      <main id="main" tabindex="-1" class="proto-main">
        <slot />
      </main>

      <div id="nogl" hidden></div>
    </div>

    <script>
      import '../prototype/js/main.js';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 80;
    padding: 12px 20px;
    border-radius: 999px;
    background: #1b1208;
    color: #fff6e8;
    font:
      600 15px 'Instrument Sans',
      system-ui,
      sans-serif;
    text-decoration: none;
    transform: translateY(-220%);
  }
  .skip-link:focus {
    transform: none;
  }
  .proto-main:focus {
    outline: none;
  }
  :where(a, button, input, select, textarea, [tabindex]):focus-visible,
  .skip-link:focus {
    outline: 3px solid #ffb45e;
    outline-offset: 3px;
  }
</style>
