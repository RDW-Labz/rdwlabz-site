---
/**
 * RDW Labz mark: a rounded ink tile holding a flask with sun-colored liquid.
 * `variant="mark"` renders the icon only; `onInk` swaps the wordmark to light text.
 */
interface Props {
  variant?: 'full' | 'mark';
  size?: number;
  onInk?: boolean;
  class?: string;
  /** Set when the logo is the only content of a link, so the link has a name. */
  label?: string;
}

const { variant = 'full', size = 40, onInk = false, class: className, label } = Astro.props;
---

<span class:list={['logo', onInk && 'logo--on-ink', className]}>
  <svg
    class="logo__mark"
    viewBox="0 0 40 40"
    width={size}
    height={size}
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
  >
    <rect x="1" y="1" width="38" height="38" rx="12" fill="#1e1433"></rect>
    {onInk && (
      <rect
        x="1"
        y="1"
        width="38"
        height="38"
        rx="12"
        fill="none"
        stroke="#fff6ea"
        stroke-width="2"
      />
    )}
    <path
      d="M14.4 27h11.2l1.7 2.9a1.5 1.5 0 0 1-1.3 2.2H14a1.5 1.5 0 0 1-1.3-2.2Z"
      fill="#ffc23d"
    ></path>
    <path
      d="M16 9h8M17.6 9v7.6l-6.2 10.8A2.5 2.5 0 0 0 13.6 31h12.8a2.5 2.5 0 0 0 2.2-3.6l-6.2-10.8V9"
      fill="none"
      stroke="#fff6ea"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="logo__bubble" cx="21.6" cy="22.4" r="1.7" fill="#ff4d2e"></circle>
  </svg>
  {variant === 'full' && (
    <span class="logo__word">
      RDW <span class="logo__labz">Labz</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-ink);
  }
  .logo__mark {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-spring);
  }
  :global(a:hover) > .logo .logo__mark,
  :global(a:focus-visible) > .logo .logo__mark {
    transform: rotate(-8deg) scale(1.05);
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }
  .logo__labz {
    color: var(--color-tomato-700);
  }
  .logo--on-ink {
    color: #fff;
  }
  .logo--on-ink .logo__labz {
    color: var(--color-sun);
  }
</style>
