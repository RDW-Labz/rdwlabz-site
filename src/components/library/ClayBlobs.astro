---
/**
 * Placeholder loop until the real clips land in public/library/video/ (docs/LIBRARY-VIDEOS.md):
 * plasticine blobs that squash, drift and wobble like stop-motion clay. CSS transforms only;
 * paused offscreen, in hidden tabs and by "Pause animations"; static under reduced motion.
 */
interface Props {
  variant?: 'teaser' | 'hero';
}
const { variant = 'teaser' } = Astro.props;
const blobs = [
  { c: '#ff8a5c', x: 8, y: 18, s: 34, d: 0 },
  { c: '#ffc23d', x: 70, y: 8, s: 26, d: -1.6 },
  { c: '#16b67e', x: 82, y: 58, s: 30, d: -3.1 },
  { c: '#3d7bff', x: 30, y: 66, s: 22, d: -0.8 },
  { c: '#ff5fa2', x: 52, y: 30, s: 18, d: -2.4 },
  { c: '#b04cf0', x: 14, y: 72, s: 16, d: -4 },
];
---

<div class:list={['clay', `clay--${variant}`]} aria-hidden="true" data-loop>
  {blobs.map((b) => (
    <span
      class="clay__blob"
      style={`--c:${b.c}; --x:${b.x}%; --y:${b.y}%; --s:${b.s}; --d:${b.d}s`}
    />
  ))}
</div>

<style>
  .clay {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 85% 10%, rgb(255 95 162 / 0.45), transparent 70%),
      radial-gradient(60% 80% at 0% 100%, rgb(255 194 61 / 0.35), transparent 70%),
      linear-gradient(160deg, #3a1d5c, #1e1433 70%);
  }
  .clay--hero {
    background:
      radial-gradient(70% 90% at 90% 0%, rgb(255 194 61 / 0.5), transparent 70%),
      radial-gradient(60% 80% at 0% 100%, rgb(22 182 126 / 0.35), transparent 70%),
      linear-gradient(165deg, #ffd2e1, #ffe0bd 60%, #fff1dc);
  }
  .clay__blob {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--s) * 1vmin + 40px);
    aspect-ratio: 1.15;
    border-radius: 48% 52% 44% 56% / 55% 45% 55% 45%;
    background:
      radial-gradient(40% 35% at 32% 28%, rgb(255 255 255 / 0.55), transparent 70%),
      radial-gradient(70% 60% at 70% 80%, rgb(30 20 51 / 0.32), transparent 70%), var(--c);
    box-shadow:
      inset -6px -8px 0 rgb(30 20 51 / 0.12),
      0 10px 0 rgb(30 20 51 / 0.18);
    animation:
      clay-drift 9s steps(36) infinite alternate,
      clay-squash 1.8s steps(6) infinite;
    animation-delay: var(--d), var(--d);
  }
  @keyframes clay-drift {
    from {
      translate: 0 0;
      rotate: -8deg;
    }
    to {
      translate: 6vmin -5vmin;
      rotate: 10deg;
    }
  }
  @keyframes clay-squash {
    0%,
    100% {
      scale: 1 1;
    }
    40% {
      scale: 1.08 0.93;
    }
    70% {
      scale: 0.95 1.06;
    }
  }
  .clay[data-paused='true'] .clay__blob {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .clay__blob {
      animation: none !important;
    }
  }
</style>
