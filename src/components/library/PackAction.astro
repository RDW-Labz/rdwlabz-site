---
import Icon from '../Icon.astro';

/**
 * Downloads are off for every pack until the store opens: a non-interactive pill, never a
 * dead link, never a buy button.
 */
interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['btn', size === 'sm' && 'btn--sm']} aria-disabled="true" data-pack-action="soon">
  <Icon name="clock" size={18} />
  Downloads coming soon
</span>
