---
import { libraryVideo } from '../../lib/library';

/**
 * Full-screen "portal" loading screen for "Enter the Library" (scripts/portal.ts).
 * Uses public/library/video/portal.* when present; otherwise a CSS clay vortex.
 * Hidden until a portal link is clicked; leaves with the page's View Transition.
 */
const clip = libraryVideo('portal');
const rings = ['#ff4d2e', '#ffc23d', '#16b67e', '#3d7bff', '#b04cf0', '#ff5fa2'];
---

<div
  class="portal"
  role="dialog"
  aria-modal="true"
  aria-label="Entering the Clay Asset Library"
  hidden
  data-portal-overlay
  data-webm={clip?.webm}
  data-mp4={clip?.mp4}
  data-webm-portrait={clip?.webmPortrait}
  data-mp4-portrait={clip?.mp4Portrait}
>
  <div class="portal__vortex" aria-hidden="true">
    {rings.map((c, i) => (
      <span class="portal__ring" style={`--c:${c}; --i:${i}`} />
    ))}
    <span class="portal__core" />
  </div>
  <p class="portal__label">
    <span class="portal__label-text">Entering the Clay Asset Library…</span>
  </p>
  <button type="button" class="btn btn--sm portal__skip" data-portal-skip>
    Skip <kbd>Esc</kbd>
  </button>
</div>

<style>
  .portal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(60% 60% at 50% 50%, #3a1d5c, transparent 75%), var(--color-ink);
    color: #fff;
    view-transition-name: portal;
    animation: portal-in 220ms var(--ease-out-soft) both;
  }
  .portal[hidden] {
    display: none;
  }
  .portal[data-state='fade'],
  .portal[data-state='leaving']:not(.has-video) {
    background: var(--color-paper);
  }
  .portal[data-state='fade'] {
    animation: portal-in 240ms ease-out both !important;
  }
  .portal[data-state='fade'] .portal__vortex,
  .portal[data-state='fade'] .portal__skip {
    display: none;
  }
  .portal[data-state='fade'] .portal__label {
    color: var(--color-ink);
    background: none;
    border: 0;
    box-shadow: none;
  }
  .portal :global(.portal__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .portal.has-video :global(.portal__video) {
    opacity: 1;
  }
  .portal.has-video .portal__vortex {
    display: none;
  }

  .portal__vortex {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .portal__ring {
    position: absolute;
    width: calc(30vmin + var(--i) * 13vmin);
    aspect-ratio: 1;
    border-radius: 47% 53% 50% 50% / 52% 48% 52% 48%;
    border: calc(4vmin - var(--i) * 0.35vmin) solid var(--c);
    box-shadow:
      inset 0 0.8vmin 0 rgb(255 255 255 / 0.28),
      0 0.8vmin 0 rgb(0 0 0 / 0.25);
    animation:
      portal-spin calc(1.4s + var(--i) * 0.25s) steps(18) infinite,
      portal-zoom 2.4s cubic-bezier(0.5, 0, 0.9, 0.4) both;
    animation-direction: normal, normal;
  }
  .portal__ring:nth-child(even) {
    animation-direction: reverse, normal;
  }
  .portal__core {
    width: 22vmin;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #fff6ea, #ffc23d 45%, #ff5fa2 80%);
    box-shadow: 0 0 6vmin 2vmin rgb(255 194 61 / 0.55);
    animation: portal-core 2.4s cubic-bezier(0.6, 0, 0.9, 0.3) both;
  }
  .portal__label {
    position: relative;
    margin: 0;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-ink);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 5px 0 var(--color-ink);
    font-family: var(--font-bagel), system-ui, sans-serif;
    font-size: clamp(1.125rem, 0.9rem + 1.2vw, 1.75rem);
    translate: 0 30vmin;
  }
  .portal__skip {
    position: absolute;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
  }
  .portal__skip kbd {
    font: inherit;
    font-size: var(--text-chip);
    padding: 1px 6px;
    border-radius: 6px;
    border: 1.5px solid currentColor;
    opacity: 0.8;
  }

  @keyframes portal-in {
    from {
      opacity: 0;
    }
  }
  @keyframes portal-spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes portal-zoom {
    from {
      scale: 0.2;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    to {
      scale: 2.6;
    }
  }
  @keyframes portal-core {
    from {
      scale: 0.1;
    }
    70% {
      scale: 1;
    }
    to {
      scale: 9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal[data-state='fade'] {
      animation-duration: 240ms !important;
    }
  }
</style>

<style is:global>
  ::view-transition-old(portal) {
    animation: 320ms ease-out both portal-out;
  }
  @keyframes portal-out {
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(portal) {
      animation-duration: 240ms !important;
    }
  }
</style>
